{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Configuración menos estricta para scripts
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noUncheckedIndexedAccess": false,
    "strict": false
  },
  "include": [
    "scripts/**/*.ts",
    "e2e/**/*.{ts,tsx}"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}

