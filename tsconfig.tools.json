{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Configuración para archivos de tooling (configs, etc.)
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "*.config.ts",
    "*.config.*.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "next.config.ts",
    "sentry.client.config.ts",
    "sentry.server.config.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
