# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing/coverage
.nyc_output

# Generated test artifacts (do not commit)
playwright-report/
.tmp/

# migration backups
/.migration-backups

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# PDFs descargados de DEMRE
/data/pdfs/
/data/temp/

# Reportes de limpieza de código
cleanup-report.json

# Base de datos local (SQLite)
*.db
paes.db
dev.db

# Test results
test-results/

# Artefactos temporales y reportes
*.txt
!README.txt
*.patch
lint-*.txt
*-output.txt
*-check.txt
*-analysis.txt
*-before.txt
*-after.txt
*-final.txt
*-errors-list.txt
*-warnings-list.txt
build-output.txt
eslint-src-output.txt
migration-report*.json
node-version.txt
npm-version.txt
last-commit-before.txt
