{
  "extends": "./tsconfig.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "e2e/**/*.ts",
    "e2e/**/*.tsx",
    "scripts/**/*.ts",
    "prisma/**/*.ts",
    "vitest.setup.ts",
    "vitest.config.ts",
    "next.config.ts",
    "proxy.ts",
    "sentry*.ts",
    "*.config.ts",
    "*.config.js",
    "*.config.mjs"
  ],
  "exclude": ["node_modules", ".next", "dist", "coverage", "test-results", "playwright-report"]
}
