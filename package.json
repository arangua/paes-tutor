{
  "name": "paes-tutor",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24"
  },
  "overrides": {
    "hono": "^4.11.7",
    "lodash": "^4.17.23",
    "@isaacs/brace-expansion": "^5.0.1"
  },
  "scripts": {
    "dev": "next dev",
    "dev:safe": "powershell -ExecutionPolicy Bypass -File scripts/start-dev.ps1",
    "dev:clean": "powershell -ExecutionPolicy Bypass -File scripts/clean-start.ps1 && npm run dev",
    "clean": "powershell -ExecutionPolicy Bypass -File scripts/clean-start.ps1",
    "clean:force": "powershell -ExecutionPolicy Bypass -File scripts/clean-start.ps1 -Force",
    "build": "next build",
    "vercel-build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings 0 --ignore-pattern \"e2e/**\" --ignore-pattern \"playwright.config.ts\"",
    "lint:e2e": "powershell -ExecutionPolicy Bypass -File scripts/run-lint-e2e-isolated.ps1",
    "lint:next": "next lint",
    "lint:critical": "node scripts/lint-critical.mjs",
    "lint:changed": "powershell -ExecutionPolicy Bypass -File scripts/lint-changed-files.ps1",
    "lint:full": "eslint . --ignore-pattern \"e2e/**\" --ignore-pattern \"playwright.config.ts\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:db": "vitest run",
    "test:db:studynote": "vitest run src/lib/study-notes/__tests__/study-note-versioning.test.ts",
    "test:prisma": "vitest run src/lib/__tests__/prisma.test.ts prisma/__tests__/schema-validation.test.ts",
    "test:run:silent": "powershell -ExecutionPolicy Bypass -File scripts/run-tests-silent.ps1",
    "test:run:optimized": "powershell -ExecutionPolicy Bypass -File scripts/run-tests-optimized.ps1",
    "test:smoke": "vitest run --no-file-parallelism --testTimeout=30000 src/app/api/sentry-smoke/route.test.ts",
    "test:smoke:coverage": "vitest run --coverage --no-file-parallelism --testTimeout=30000 src/app/api/sentry-smoke/route.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ui": "vitest --coverage --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "analyze": "ANALYZE=true npm run build",
    "postinstall": "prisma generate",
    "prepare": "node -e \"try { if (require('fs').existsSync('node_modules/husky')) require('husky').install() } catch (e) {}\"",
    "import:demre": "npx tsx scripts/import-demre-exams.ts",
    "sonar": "sonar-scanner",
    "sonar:local": "sonar-scanner -Dsonar.host.url=http://localhost:9000",
    "test:coverage:sonar": "node scripts/vitest-ci-watchdog.mjs",
    "test:coverage:sonar:ps1": "powershell -ExecutionPolicy Bypass -File scripts/run-test-coverage-sonar.ps1",
    "test:mutation": "stryker run",
    "test:mutation:deep": "stryker run --mutate src/**/*.{ts,tsx} --maxConcurrentTestRunners 1",
    "migrate-validations": "tsx scripts/migrate-validations.ts",
    "migrate-validations:dry-run": "tsx scripts/migrate-validations.ts --dry-run",
    "migrate-validations-safe": "tsx scripts/migrate-validations-safe.ts",
    "migrate-validations-safe:dry-run": "tsx scripts/migrate-validations-safe.ts --dry-run",
    "check:critical-issues": "npm run lint:critical && npm run lint:changed && npm run test:run",
    "check:critical-issues:ps1": "powershell -ExecutionPolicy Bypass -File scripts/check-critical-issues.ps1",
    "validate:pre-commit": "tsx scripts/validate-pre-commit.ts",
    "validate:types": "powershell -ExecutionPolicy Bypass -File scripts/check-types-local.ps1",
    "validate:types:direct": "tsc --noEmit",
    "guard:prisma": "node scripts/guard-prisma-engine.mjs",
    "guard:lockfile-policy": "node scripts/guard-lockfile-policy.mjs",
    "guard:deps-snapshot": "node scripts/guard-deps-snapshot.mjs",
    "guard:deps-snapshot:write": "node scripts/guard-deps-snapshot.mjs --write",
    "guard:repo-clean": "node scripts/guard-repo-clean.mjs",
    "validate:secrets": "tsx scripts/validate-secrets.ts",
    "validate:all": "npm run validate:types && npm run lint:strict && npm run validate:secrets",
    "validate:form-fields": "tsx scripts/validate-form-fields.ts",
    "guard:no-global-patches": "node ./scripts/guard-no-global-patches.mjs",
    "guard:auth-mock-first": "node scripts/guard-auth-mock-first.mjs",
    "guard:route-tests-node-env": "node scripts/guard-route-tests-node-env.mjs",
    "guard:no-hardcoded-secrets": "node scripts/guard-no-hardcoded-secrets.mjs",
    "guard:ci-clean-output": "node scripts/guard-ci-clean-output.mjs",
    "guard:contracts": "node ./scripts/guard-contracts.mjs",
    "guard:prod-ready": "node ./scripts/guard-prod-ready.mjs",
    "guard:ux": "node ./scripts/guard-ux-patterns.mjs",
    "contracts:test": "vitest run src/lib/contracts",
    "ci:check": "npm run guard:prisma && npm run guard:lockfile-policy && npm run guard:deps-snapshot && npm run guard:no-global-patches && npm run guard:auth-mock-first && npm run guard:route-tests-node-env && npm run guard:no-hardcoded-secrets && npm run guard:contracts && npm run guard:prod-ready && npm run guard:ux && npm run contracts:test && npm run lint:critical && npm run test:run && npm run guard:repo-clean",
    "ci:check:guards-only": "npm run guard:prisma && npm run guard:lockfile-policy && npm run guard:deps-snapshot && npm run guard:no-global-patches && npm run guard:auth-mock-first && npm run guard:route-tests-node-env && npm run guard:no-hardcoded-secrets && npm run guard:contracts && npm run guard:prod-ready && npm run guard:ux && npm run contracts:test && npm run lint:critical",
    "typecheck": "tsc --noEmit",
    "ci:release": "npm run ci:check && npm run typecheck && npm run lint && npm run build",
    "cleanup:imports": "tsx scripts/cleanup-unused-imports.ts",
    "cleanup:imports:fix": "tsx scripts/cleanup-unused-imports.ts --fix",
    "cleanup:imports:verbose": "tsx scripts/cleanup-unused-imports.ts --fix --verbose",
    "cleanup:imports:report": "tsx scripts/cleanup-unused-imports.ts --fix --report",
    "prebuild": "tsx scripts/pre-build-check.ts",
    "prebuild:skip": "echo 'Skipping pre-build checks'",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:seed:baseline": "npx tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write",
      "powershell -ExecutionPolicy Bypass -File scripts/check-types-local.ps1"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@auth/prisma-adapter": "^2.11.1",
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "10.32.1",
    "@types/cheerio": "^0.22.35",
    "@types/crypto-js": "^4.2.2",
    "@types/jszip": "^3.4.0",
    "@types/react-window": "^1.8.8",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.35.8",
    "@vitest/coverage-istanbul": "^4.0.16",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.5.0",
    "c8": "^10.1.3",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "docx": "^9.5.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "hono": "^4.11.7",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "lodash": "^4.17.23",
    "lucide-react": "^0.562.0",
    "next": "^16.1.5",
    "next-auth": "^5.0.0-beta.30",
    "openai": "^6.16.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-window": "^2.2.3",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "undici": "^7.18.2",
    "why-is-node-running": "^3.2.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.1",
    "@playwright/test": "^1.57.0",
    "@stryker-mutator/core": "^9.4.0",
    "@stryker-mutator/typescript-checker": "^9.4.0",
    "@stryker-mutator/vitest-runner": "^9.4.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/file-saver": "^2.0.7",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "glob": "^13.0.0",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "prisma": "^7.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16"
  }
}
