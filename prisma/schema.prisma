datasource db {
  provider = "sqlite"
}

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  password           String? // Para autenticación con credenciales
  role               String    @default("student") // Roles: 'student', 'admin', 'teacher'
  // API Keys para servicios de IA (encriptadas)
  openaiApiKey       String? // API Key de OpenAI (ChatGPT)
  anthropicApiKey    String? // API Key de Anthropic (Claude)
  geminiApiKey       String? // API Key de Google (Gemini)
  preferredAIService String? // Servicio preferido: 'openai', 'anthropic', 'gemini'
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  student  Student?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Student {
  id        String   @id @default(cuid())
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  nombre    String
  createdAt DateTime @default(now())

  attempts         Attempt[]
  metrics          PerformanceMetric[]
  practiceSessions PracticeSession[]
  bookmarks        Bookmark[]
  flashcards       Flashcard[]
  studyNotes       StudyNote[]
  studySchedules   StudySchedule[]
}

model Subject {
  id     String @id @default(cuid())
  codigo String @unique
  nombre String
  tipo   String

  topics    Topic[]
  questions Question[]
  exams     Exam[]
  materials StudyMaterial[]
}

model Topic {
  id          String  @id @default(cuid())
  subjectId   String
  subject     Subject @relation(fields: [subjectId], references: [id])
  nombre      String
  ejeTematico String
  descripcion String?

  questions        Question[]
  materials        StudyMaterial[]
  metrics          PerformanceMetric[]
  practiceSessions PracticeSession[]
  studyNotes       StudyNote[]
  studySchedules    StudySchedule[]

  @@index([subjectId])
}

model StudyMaterial {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  topicId   String?
  topic     Topic?   @relation(fields: [topicId], references: [id])
  titulo    String
  contenido String
  fuente    String?
  tipo      String
  createdAt DateTime @default(now())

  @@index([subjectId, topicId])
}

model Question {
  id          String   @id @default(cuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  topicId     String?
  topic       Topic?   @relation(fields: [topicId], references: [id])
  enunciado   String
  dificultad  Int
  explicacion String
  fuente      String
  tipo        String
  createdAt   DateTime @default(now())

  options         QuestionOption[]
  examQuestions   ExamQuestion[]
  answers         AttemptAnswer[]
  practiceAnswers PracticeAnswer[]
  bookmarks       Bookmark[]
  flashcards      Flashcard[]
  studyNotes      StudyNote[]

  @@index([subjectId, topicId])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  letra      String
  texto      String
  esCorrecta Boolean  @default(false)

  answers         AttemptAnswer[]
  practiceAnswers PracticeAnswer[]
}

model Exam {
  id              String   @id @default(cuid())
  subjectId       String
  subject         Subject  @relation(fields: [subjectId], references: [id])
  titulo          String
  descripcion     String?
  tipo            String
  tiempoLimiteMin Int?
  totalPreguntas  Int
  fuente          String?
  createdAt       DateTime @default(now())

  questions      ExamQuestion[]
  attempts       Attempt[]
  studySchedules StudySchedule[]

  @@index([subjectId, tipo])
  @@index([tipo, createdAt])
}

model ExamQuestion {
  id         String   @id @default(cuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  orden      Int

  @@unique([examId, questionId])
  @@unique([examId, orden])
}

model ScoreTable {
  id             String @id @default(cuid())
  subjectCodigo  String
  proceso        String
  tipoAplicacion String
  forma          String
  correctas      Int
  puntajePaes    Int

  @@unique([subjectCodigo, proceso, tipoAplicacion, forma, correctas])
  @@index([subjectCodigo, proceso, tipoAplicacion, forma])
}

model Attempt {
  id               String    @id @default(cuid())
  studentId        String
  student          Student   @relation(fields: [studentId], references: [id])
  examId           String
  exam             Exam      @relation(fields: [examId], references: [id])
  proceso          String?
  tipoAplicacion   String?
  forma            String?
  estado           String    @default("en_progreso")
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  duracionSegundos Int?
  totalPreguntas   Int       @default(0)
  correctas        Int       @default(0)
  incorrectas      Int       @default(0)
  omitidas         Int       @default(0)
  porcentaje       Float     @default(0)
  puntajePaes      Int?
  puntajeEstimado  Boolean   @default(false)
  analisisIA       String?
  fortalezas       String?
  debilidades      String?
  recomendaciones  String?
  createdAt        DateTime  @default(now())

  answers AttemptAnswer[]

  @@index([studentId, createdAt])
  @@index([studentId, estado])
  @@index([studentId, examId, estado])
  @@index([examId, estado])
  @@index([estado, createdAt])
}

model AttemptAnswer {
  id               String          @id @default(cuid())
  attemptId        String
  attempt          Attempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question        @relation(fields: [questionId], references: [id])
  optionSelectedId String?
  optionSelected   QuestionOption? @relation(fields: [optionSelectedId], references: [id])
  esCorrecta       Boolean?
  omitida          Boolean         @default(false)
  tiempoSegundos   Int?
  explicacionIA    String?

  @@unique([attemptId, questionId])
  @@index([attemptId, esCorrecta])
  @@index([questionId, esCorrecta])
}

model PerformanceMetric {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id])
  topicId        String
  topic          Topic    @relation(fields: [topicId], references: [id])
  totalPreguntas Int      @default(0)
  correctas      Int      @default(0)
  porcentaje     Float    @default(0)
  nivel          String?
  tendencia      String?
  updatedAt      DateTime @updatedAt

  @@unique([studentId, topicId])
}

model PracticeSession {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id])
  topicId        String
  topic          Topic    @relation(fields: [topicId], references: [id])
  totalPreguntas Int      @default(0)
  correctas      Int      @default(0)
  incorrectas    Int      @default(0)
  omitidas       Int      @default(0)
  porcentaje     Float    @default(0)
  duracionSegundos Int?
  startedAt      DateTime @default(now())
  finishedAt     DateTime?

  answers        PracticeAnswer[]

  @@index([studentId, topicId])
  @@index([studentId, startedAt])
}

model PracticeAnswer {
  id               String          @id @default(cuid())
  practiceSessionId String
  practiceSession  PracticeSession @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question        @relation(fields: [questionId], references: [id])
  optionSelectedId String?
  optionSelected   QuestionOption? @relation(fields: [optionSelectedId], references: [id])
  esCorrecta       Boolean?
  omitida          Boolean         @default(false)
  tiempoSegundos   Int?

  @@unique([practiceSessionId, questionId])
  @@index([practiceSessionId, esCorrecta])
}

model Bookmark {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  notes      String?  // Notas opcionales sobre la pregunta

  @@unique([studentId, questionId])
  @@index([studentId, createdAt])
  @@index([questionId])
}

model Flashcard {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId  String?
  question    Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  front       String   // Pregunta o concepto (anverso)
  back        String   // Respuesta o explicación (reverso)
  difficulty  Float    @default(2.5) // Factor de dificultad (algoritmo SM-2)
  lastReview  DateTime @default(now())
  nextReview  DateTime @default(now()) // Próxima fecha de repaso
  reviewCount Int      @default(0) // Número de repasos
  easeFactor  Float    @default(2.5) // Factor de facilidad (SM-2)
  interval    Int      @default(1) // Intervalo en días hasta próximo repaso
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId, nextReview])
  @@index([studentId, createdAt])
}

model StudyNote {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId String?
  question    Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  topicId     String?
  topic       Topic?   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title       String
  content     String
  tags        String?  // Tags separados por comas
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId, createdAt])
  @@index([studentId, topicId])
  @@index([questionId])
}

model StudySchedule {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  description String?
  scheduledAt DateTime // Fecha y hora de la sesión
  durationMinutes Int  @default(60) // Duración en minutos
  type        String   // 'exam', 'practice', 'review', 'flashcards', 'custom'
  topicId     String?
  topic       Topic?   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  examId      String?
  exam        Exam?    @relation(fields: [examId], references: [id], onDelete: Cascade)
  completed   Boolean  @default(false)
  completedAt DateTime?
  reminderSent Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId, scheduledAt])
  @@index([studentId, completed])
  @@index([scheduledAt])
}
