generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  role               String    @default("student")
  openaiApiKey       String?
  anthropicApiKey    String?
  geminiApiKey       String?
  preferredAIService String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  accounts           Account[]
  sessions           Session[]
  student            Student?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Student {
  id                   String              @id @default(cuid())
  userId               String?             @unique
  nombre               String
  createdAt            DateTime            @default(now())
  attempts             Attempt[]
  bookmarks            Bookmark[]
  challengesReceived   Challenge[]         @relation("Challenged")
  challengesSent       Challenge[]         @relation("Challenger")
  challengesWon        Challenge[]         @relation("Winner")
  flashcards           Flashcard[]
  notifications        Notification[]
  metrics              PerformanceMetric[]
  practiceSessions     PracticeSession[]
  sharedExams          SharedExam[]        @relation("SharedBy")
  receivedExams        SharedExam[]        @relation("SharedWith")
  sharedFlashcards     SharedFlashcard[]   @relation("SharedFlashcardBy")
  receivedFlashcards   SharedFlashcard[]   @relation("SharedFlashcardWith")
  sharedMaterials      SharedMaterial[]    @relation("SharedBy")
  receivedMaterials    SharedMaterial[]    @relation("SharedWith")
  sharedNotes          SharedNote[]        @relation("SharedNoteBy")
  receivedNotes        SharedNote[]        @relation("SharedNoteWith")
  sharedNoteVersions   SharedNoteVersion[] @relation("SharedNoteVersionBy")
  receivedNoteVersions SharedNoteVersion[] @relation("SharedNoteVersionWith")
  user                 User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyNotes           StudyNote[]
  studySchedules       StudySchedule[]
  webhooks             Webhook[]
}

model Subject {
  id        String          @id @default(cuid())
  codigo    String          @unique
  nombre    String
  tipo      String
  exams     Exam[]
  questions Question[]
  materials StudyMaterial[]
  topics    Topic[]
}

model Topic {
  id                   String              @id @default(cuid())
  subjectId            String
  nombre               String
  ejeTematico          String
  descripcion          String?
  codigoTemarioOficial String?
  habilidadesTemario   String?
  vigenciaDesde        String?
  vigenciaHasta        String?
  metrics              PerformanceMetric[]
  practiceSessions     PracticeSession[]
  questions            Question[]
  materials            StudyMaterial[]
  studyNotes           StudyNote[]
  studySchedules       StudySchedule[]
  subject              Subject             @relation(fields: [subjectId], references: [id])

  @@index([subjectId])
  @@index([codigoTemarioOficial])
}

model StudyMaterial {
  id              String           @id @default(cuid())
  subjectId       String
  topicId         String?
  titulo          String
  contenido       String
  fuente          String?
  tipo            String
  createdAt       DateTime         @default(now())
  sharedMaterials SharedMaterial[]
  subject         Subject          @relation(fields: [subjectId], references: [id])
  topic           Topic?           @relation(fields: [topicId], references: [id])

  @@index([subjectId, topicId])
}

model Question {
  id              String           @id @default(cuid())
  subjectId       String
  topicId         String?
  enunciado       String
  dificultad      Int
  explicacion     String
  fuente          String
  tipo            String
  createdAt       DateTime         @default(now())
  answers         AttemptAnswer[]
  bookmarks       Bookmark[]
  examQuestions   ExamQuestion[]
  flashcards      Flashcard[]
  practiceAnswers PracticeAnswer[]
  subject         Subject          @relation(fields: [subjectId], references: [id])
  topic           Topic?           @relation(fields: [topicId], references: [id])
  options         QuestionOption[]
  studyNotes      StudyNote[]

  @@index([subjectId, topicId])
}

model QuestionOption {
  id              String           @id @default(cuid())
  questionId      String
  letra           String
  texto           String
  esCorrecta      Boolean          @default(false)
  answers         AttemptAnswer[]
  practiceAnswers PracticeAnswer[]
  question        Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Exam {
  id                  String          @id @default(cuid())
  subjectId           String
  titulo              String
  descripcion         String?
  tipo                String
  tiempoLimiteMin     Int?
  totalPreguntas      Int
  fuente              String?
  esSimulacionOficial Boolean         @default(false)
  fuenteSimulacion    String?
  fechaSimulacion     DateTime?
  procesoAdmision     String?
  createdAt           DateTime        @default(now())
  attempts            Attempt[]
  challenges          Challenge[]
  subject             Subject         @relation(fields: [subjectId], references: [id])
  questions           ExamQuestion[]
  sharedExams         SharedExam[]
  studySchedules      StudySchedule[]

  @@index([subjectId, tipo])
  @@index([tipo, createdAt])
  @@index([esSimulacionOficial])
  @@index([procesoAdmision])
}

model ExamQuestion {
  id         String   @id @default(cuid())
  examId     String
  questionId String
  orden      Int
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id])

  @@unique([examId, questionId])
  @@unique([examId, orden])
}

model ScoreTable {
  id             String @id @default(cuid())
  subjectCodigo  String
  proceso        String
  tipoAplicacion String
  forma          String
  correctas      Int
  puntajePaes    Int

  @@unique([subjectCodigo, proceso, tipoAplicacion, forma, correctas])
  @@index([subjectCodigo, proceso, tipoAplicacion, forma])
}

model Attempt {
  id                   String          @id @default(cuid())
  studentId            String
  examId               String
  proceso              String?
  tipoAplicacion       String?
  forma                String?
  estado               String          @default("en_progreso")
  startedAt            DateTime        @default(now())
  finishedAt           DateTime?
  duracionSegundos     Int?
  totalPreguntas       Int             @default(0)
  correctas            Int             @default(0)
  incorrectas          Int             @default(0)
  omitidas             Int             @default(0)
  porcentaje           Float           @default(0)
  puntajePaes          Int?
  puntajeEstimado      Boolean         @default(false)
  analisisIA           String?
  fortalezas           String?
  debilidades          String?
  recomendaciones      String?
  createdAt            DateTime        @default(now())
  exam                 Exam            @relation(fields: [examId], references: [id])
  student              Student         @relation(fields: [studentId], references: [id])
  answers              AttemptAnswer[]
  challengedChallenges Challenge[]     @relation("ChallengedAttempt")
  challengerChallenges Challenge[]     @relation("ChallengerAttempt")

  @@index([studentId, createdAt])
  @@index([studentId, estado])
  @@index([studentId, examId, estado])
  @@index([examId, estado])
  @@index([estado, createdAt])
}

model AttemptAnswer {
  id               String          @id @default(cuid())
  attemptId        String
  questionId       String
  optionSelectedId String?
  esCorrecta       Boolean?
  omitida          Boolean         @default(false)
  tiempoSegundos   Int?
  explicacionIA    String?
  attempt          Attempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  optionSelected   QuestionOption? @relation(fields: [optionSelectedId], references: [id])
  question         Question        @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([attemptId, esCorrecta])
  @@index([questionId, esCorrecta])
}

model PerformanceMetric {
  id             String   @id @default(cuid())
  studentId      String
  topicId        String
  totalPreguntas Int      @default(0)
  correctas      Int      @default(0)
  porcentaje     Float    @default(0)
  nivel          String?
  tendencia      String?
  updatedAt      DateTime @updatedAt
  student        Student  @relation(fields: [studentId], references: [id])
  topic          Topic    @relation(fields: [topicId], references: [id])

  @@unique([studentId, topicId])
}

model PracticeSession {
  id               String           @id @default(cuid())
  studentId        String
  topicId          String
  totalPreguntas   Int              @default(0)
  correctas        Int              @default(0)
  incorrectas      Int              @default(0)
  omitidas         Int              @default(0)
  porcentaje       Float            @default(0)
  duracionSegundos Int?
  startedAt        DateTime         @default(now())
  finishedAt       DateTime?
  answers          PracticeAnswer[]
  student          Student          @relation(fields: [studentId], references: [id])
  topic            Topic            @relation(fields: [topicId], references: [id])

  @@index([studentId, topicId])
  @@index([studentId, startedAt])
}

model PracticeAnswer {
  id                String          @id @default(cuid())
  practiceSessionId String
  questionId        String
  optionSelectedId  String?
  esCorrecta        Boolean?
  omitida           Boolean         @default(false)
  tiempoSegundos    Int?
  optionSelected    QuestionOption? @relation(fields: [optionSelectedId], references: [id])
  practiceSession   PracticeSession @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  question          Question        @relation(fields: [questionId], references: [id])

  @@unique([practiceSessionId, questionId])
  @@index([practiceSessionId, esCorrecta])
}

model Bookmark {
  id         String   @id @default(cuid())
  studentId  String
  questionId String
  createdAt  DateTime @default(now())
  notes      String?
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, questionId])
  @@index([studentId, createdAt])
  @@index([questionId])
}

model Flashcard {
  id               String            @id @default(cuid())
  studentId        String
  questionId       String?
  front            String
  back             String
  difficulty       Float             @default(2.5)
  lastReview       DateTime          @default(now())
  nextReview       DateTime          @default(now())
  reviewCount      Int               @default(0)
  easeFactor       Float             @default(2.5)
  interval         Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  question         Question?         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  student          Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sharedFlashcards SharedFlashcard[]

  @@index([studentId, nextReview])
  @@index([studentId, createdAt])
}

model StudyNote {
  id                 String                  @id @default(cuid())
  studentId          String
  questionId         String?
  topicId            String?
  title              String
  content            String
  tags               String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  createdByUserId    String?
  currentVersion     Int                     @default(1)
  updatedByUserId    String?
  sharedNotes        SharedNote[]
  sharedNoteVersions SharedNoteVersion[]
  question           Question?               @relation(fields: [questionId], references: [id], onDelete: Cascade)
  student            Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic              Topic?                  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  versions           StudyNoteVersion[]
  versionComments    VersionComment[]
  restoreHistory     VersionRestoreHistory[]

  @@index([studentId, createdAt])
  @@index([studentId, topicId])
  @@index([questionId])
}

model StudyNoteVersion {
  id              String                @id @default(cuid())
  createdAt       DateTime              @default(now())
  changeSummary   String?
  changeType      StudyNoteChangeType
  createdByUserId String?
  snapshot        Json
  snapshotHash    String?
  source          StudyNoteChangeSource @default(API)
  studyNoteId     String
  version         Int
  studyNote       StudyNote             @relation(fields: [studyNoteId], references: [id], onDelete: Cascade)

  @@unique([studyNoteId, version])
  @@index([studyNoteId, createdAt])
  @@index([createdByUserId, createdAt])
}

model VersionComment {
  id        String    @id @default(cuid())
  versionId String
  noteId    String
  comment   String
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  note      StudyNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([versionId, createdAt])
  @@index([noteId, versionId, createdAt])
  @@index([noteId])
  @@index([createdBy])
}

model VersionRestoreHistory {
  id          String    @id @default(cuid())
  actorUserId String
  createdAt   DateTime  @default(now())
  fromVersion Int
  reason      String?
  status      String
  studyNoteId String
  toVersion   Int
  studyNote   StudyNote @relation(fields: [studyNoteId], references: [id], onDelete: Cascade)

  @@index([studyNoteId, createdAt])
}

model StudySchedule {
  id              String    @id @default(cuid())
  studentId       String
  title           String
  description     String?
  scheduledAt     DateTime
  durationMinutes Int       @default(60)
  type            String
  topicId         String?
  examId          String?
  completed       Boolean   @default(false)
  completedAt     DateTime?
  reminderSent    Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  exam            Exam?     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic           Topic?    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([studentId, scheduledAt])
  @@index([studentId, completed])
  @@index([scheduledAt])
}

model SharedExam {
  id           String    @id @default(cuid())
  examId       String
  sharedById   String
  sharedWithId String
  message      String?
  viewed       Boolean   @default(false)
  viewedAt     DateTime?
  createdAt    DateTime  @default(now())
  exam         Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  sharedBy     Student   @relation("SharedBy", fields: [sharedById], references: [id], onDelete: Cascade)
  sharedWith   Student   @relation("SharedWith", fields: [sharedWithId], references: [id], onDelete: Cascade)

  @@unique([examId, sharedById, sharedWithId])
  @@index([sharedWithId, viewed])
  @@index([sharedById, createdAt])
  @@index([sharedWithId, createdAt])
}

model SharedMaterial {
  id           String        @id @default(cuid())
  materialId   String
  sharedById   String
  sharedWithId String
  message      String?
  viewed       Boolean       @default(false)
  viewedAt     DateTime?
  createdAt    DateTime      @default(now())
  material     StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  sharedBy     Student       @relation("SharedBy", fields: [sharedById], references: [id], onDelete: Cascade)
  sharedWith   Student       @relation("SharedWith", fields: [sharedWithId], references: [id], onDelete: Cascade)

  @@unique([materialId, sharedById, sharedWithId])
  @@index([sharedWithId, viewed])
  @@index([sharedById, createdAt])
  @@index([sharedWithId, createdAt])
}

model SharedFlashcard {
  id           String    @id @default(cuid())
  flashcardId  String
  sharedById   String
  sharedWithId String
  message      String?
  viewed       Boolean   @default(false)
  viewedAt     DateTime?
  createdAt    DateTime  @default(now())
  flashcard    Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  sharedBy     Student   @relation("SharedFlashcardBy", fields: [sharedById], references: [id], onDelete: Cascade)
  sharedWith   Student   @relation("SharedFlashcardWith", fields: [sharedWithId], references: [id], onDelete: Cascade)

  @@unique([flashcardId, sharedById, sharedWithId])
  @@index([sharedWithId, viewed])
  @@index([sharedById, createdAt])
  @@index([sharedWithId, createdAt])
}

model SharedNote {
  id           String    @id @default(cuid())
  noteId       String
  sharedById   String
  sharedWithId String
  message      String?
  viewed       Boolean   @default(false)
  viewedAt     DateTime?
  createdAt    DateTime  @default(now())
  note         StudyNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  sharedBy     Student   @relation("SharedNoteBy", fields: [sharedById], references: [id], onDelete: Cascade)
  sharedWith   Student   @relation("SharedNoteWith", fields: [sharedWithId], references: [id], onDelete: Cascade)

  @@unique([noteId, sharedById, sharedWithId])
  @@index([sharedWithId, viewed])
  @@index([sharedById, createdAt])
  @@index([sharedWithId, createdAt])
}

model SharedNoteVersion {
  id           String    @id @default(cuid())
  noteId       String
  versionId    String
  sharedById   String
  sharedWithId String
  message      String?
  viewed       Boolean   @default(false)
  viewedAt     DateTime?
  createdAt    DateTime  @default(now())
  note         StudyNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  sharedBy     Student   @relation("SharedNoteVersionBy", fields: [sharedById], references: [id], onDelete: Cascade)
  sharedWith   Student   @relation("SharedNoteVersionWith", fields: [sharedWithId], references: [id], onDelete: Cascade)

  @@unique([noteId, versionId, sharedById, sharedWithId])
  @@index([sharedWithId, viewed])
  @@index([sharedById, createdAt])
  @@index([sharedWithId, createdAt])
  @@index([versionId])
}

model Challenge {
  id                  String    @id @default(cuid())
  examId              String?
  challengerId        String
  challengedId        String
  status              String    @default("pending")
  message             String?
  deadline            DateTime?
  challengerAttemptId String?
  challengedAttemptId String?
  winnerId            String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  acceptedAt          DateTime?
  completedAt         DateTime?
  challengedAttempt   Attempt?  @relation("ChallengedAttempt", fields: [challengedAttemptId], references: [id])
  challenged          Student   @relation("Challenged", fields: [challengedId], references: [id], onDelete: Cascade)
  challengerAttempt   Attempt?  @relation("ChallengerAttempt", fields: [challengerAttemptId], references: [id])
  challenger          Student   @relation("Challenger", fields: [challengerId], references: [id], onDelete: Cascade)
  exam                Exam?     @relation(fields: [examId], references: [id], onDelete: Cascade)
  winner              Student?  @relation("Winner", fields: [winnerId], references: [id])

  @@index([challengerId, status])
  @@index([challengedId, status])
  @@index([status, createdAt])
  @@index([examId, status])
}

model AdmissionCalendar {
  id          String   @id @default(cuid())
  proceso     String
  fecha       DateTime
  hora        String?
  titulo      String
  descripcion String?
  tipo        String
  importante  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([proceso, fecha])
  @@index([tipo, fecha])
  @@index([importante, fecha])
}

model Career {
  id                  String   @id @default(cuid())
  nombre              String
  universidad         String
  proceso             String
  vacantes            Int?
  ponderacionNEM      Float
  ponderacionRanking  Float
  ponderacionLectora  Float
  ponderacionM1       Float
  ponderacionM2       Float?
  ponderacionCiencias Float?
  ponderacionHistoria Float?
  puntajeMinimo       Int?
  pruebasRequeridas   String?
  activa              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([proceso, universidad])
  @@index([nombre])
  @@index([activa])
}

model OfficialStatistics {
  id                 String   @id @default(cuid())
  prueba             String
  proceso            String
  tipoAplicacion     String?
  promedio           Float
  desviacionEstandar Float
  percentil50        Float
  percentil75        Float
  percentil90        Float
  percentil95        Float
  preguntasFaciles   Int?
  preguntasMedias    Int?
  preguntasDificiles Int?
  datosAdicionales   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([prueba, proceso, tipoAplicacion])
  @@index([prueba, proceso])
}

model ScoreTransformation {
  id           String   @id @default(cuid())
  tipo         String
  proceso      String?
  prueba       String?
  valorOrigen  Float
  valorDestino Float
  activa       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tipo, proceso, prueba])
  @@index([tipo, valorOrigen])
  @@index([activa])
}

model Notification {
  id          String    @id @default(cuid())
  studentId   String
  type        String
  title       String
  message     String
  read        Boolean   @default(false)
  readAt      DateTime?
  relatedId   String?
  relatedType String?
  actionUrl   String?
  priority    String    @default("normal")
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, read])
  @@index([studentId, createdAt])
  @@index([studentId, type])
  @@index([read, createdAt])
  @@index([expiresAt])
}

model Webhook {
  id          String            @id @default(cuid())
  studentId   String
  url         String
  secret      String?
  events      String
  active      Boolean           @default(true)
  noteId      String?
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  student     Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]

  @@index([studentId, active])
  @@index([noteId])
  @@index([active])
}

model WebhookDelivery {
  id          String    @id @default(cuid())
  webhookId   String
  event       String
  payload     String
  status      String
  statusCode  Int?
  response    String?
  attempts    Int       @default(0)
  lastAttempt DateTime?
  nextRetry   DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  webhook     Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, status])
  @@index([status, nextRetry])
  @@index([createdAt])
}

enum StudyNoteChangeType {
  CREATE
  UPDATE
  PUBLISH
  UNPUBLISH
  ARCHIVE
  RESTORE
  SYSTEM
}

enum StudyNoteChangeSource {
  UI
  API
  MIGRATION
  IMPORT
  SYSTEM
}
